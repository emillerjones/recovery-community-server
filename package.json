{
  "name": "recovery-community-server",
  "type": "module",
  "imports": {
    "#*": "./*.js"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch --env-file=.env server.js",
    "db:schema": "node --env-file=.env -e \"import('child_process').then(({execSync})=>execSync('psql -f db/schema.sql \\\"' + process.env.DATABASE_URL + '\\\"', {stdio:'inherit'}))\"",
    "db:seed": "node --env-file=.env db/seed.runner.js",
    "db:reset": "npm run db:schema && npm run db:seed",
    "test:registration": "node --env-file=.env tests/registration.integration.runner.js",
    "test:password-reset": "node --env-file=.env tests/password-reset.integration.runner.js",
    "test:pending-membership-notifications": "node --env-file=.env tests/pending-membership-notifications.integration.runner.js"
  },
  "dependencies": {
    "bcrypt": "^5.1.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.1.0",
    "express-rate-limit": "^8.6.0",
    "geoip-lite": "^2.0.3",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.1",
    "nodemailer": "^9.0.3",
    "pg": "^8.20.0",
    "socket.io": "^4.8.3"
  },
  "engines": {
    "node": ">=22"
  }
}
