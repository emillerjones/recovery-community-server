{
  "name": "recovery-community-server",
  "type": "module",
  "imports": {
    "#*": "./*.js"
  },
  "scripts": {
    "test:discount-logos": "node --env-file=.env tests/discount-logo.integration.js",
    "test:imported-posts": "node --env-file=.env tests/imported-posts.integration.js",
    "test:like-migration": "node --env-file=.env tests/like-migration.integration.js",
    "test:staff-announcements": "node --env-file=.env tests/staff-announcements.integration.js",
    "test:staff-chat": "node --env-file=.env tests/staff-chat.integration.js",
    "test:post-history": "node --env-file=.env tests/forum-post-history.integration.js",
    "start": "node server.js",
    "dev": "node --watch --env-file=.env server.js",
    "db:schema": "node --env-file=.env -e \"import('child_process').then(({execSync})=>execSync('psql -f db/schema.sql \\\"' + process.env.DATABASE_URL + '\\\"', {stdio:'inherit'}))\"",
    "db:seed": "node --env-file=.env db/seed.runner.js",
    "db:reset": "npm run db:schema && npm run db:seed",
    "test:registration": "node --env-file=.env tests/registration.integration.runner.js",
    "test:password-reset": "node --env-file=.env tests/password-reset.integration.runner.js",
    "test:pending-membership-notifications": "node --env-file=.env tests/pending-membership-notifications.integration.runner.js",
    "test:polls": "node --env-file=.env tests/forum-polls.integration.runner.js",
    "test:dm-photos": "node --env-file=.env tests/direct-message-photos.integration.runner.js",
    "test:forum-photos": "node --env-file=.env tests/forum-photos.integration.runner.js",
    "test:profile-avatar": "node --env-file=.env tests/profile-avatar.integration.runner.js",
    "test:faq2": "node --env-file=.env tests/faq2.integration.runner.js",
    "test:discount2": "node --env-file=.env tests/discount2.integration.runner.js"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cloudinary": "^2.10.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.1.0",
    "express-rate-limit": "^8.6.0",
    "geoip-lite": "^2.0.3",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.1",
    "multer": "^2.2.0",
    "nodemailer": "^9.0.3",
    "pg": "^8.20.0",
    "sharp": "^0.35.3",
    "socket.io": "^4.8.3"
  },
  "engines": {
    "node": ">=22"
  }
}
